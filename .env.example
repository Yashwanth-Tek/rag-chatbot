# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# ── Database ─────────────────────────────────────────────────────────────
# Use 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 first and can stall.
DATABASE_URL=postgresql://rag_user:change-me@127.0.0.1:5432/rag
# Read by docker-compose to create the container's database; must match DATABASE_URL.
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag

# ── Embeddings ───────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Task prefixes the embedding model expects (these are nomic-embed-text's).
# Quoted so the trailing space is kept.
OLLAMA_QUERY_PREFIX="search_query: "
OLLAMA_DOCUMENT_PREFIX="search_document: "
EMBEDDING_DIMENSION=768

# ── LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
# Backend only; never sent to the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max  (high is the API default)
ANTHROPIC_EFFORT=high
ANTHROPIC_TIMEOUT_SECONDS=90

# ── Ingestion ────────────────────────────────────────────────────────────
# Files are held in memory while they are checked and parsed; the backend accepts up to 1024.
MAX_UPLOAD_MB=500
CHUNK_SIZE_CHARS=2000
CHUNK_OVERLAP_CHARS=200

# ── Retrieval & guardrails ───────────────────────────────────────────────
RETRIEVAL_TOP_K=12
# Chunks scoring below this cosine similarity are never sent to Claude.
# Model-specific: recalibrate whenever the embedding model changes (see README).
RETRIEVAL_MIN_SIMILARITY=0.50

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
